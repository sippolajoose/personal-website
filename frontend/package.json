{
  "name": "@site/frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node ../node_modules/vite/bin/vite.js",
    "build": "node ../node_modules/vue-tsc/bin/vue-tsc.js -p tsconfig.json --noEmit && node ../node_modules/vite/bin/vite.js build",
    "preview": "node ../node_modules/vite/bin/vite.js preview",
    "typecheck": "node ../node_modules/vue-tsc/bin/vue-tsc.js -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "naive-ui": "^2.42.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "^5.8.3",
    "vite": "^6.0.0",
    "vue-tsc": "^2.2.0"
  }
}
